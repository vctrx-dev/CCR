{
  "name": "@vctrx/ccr",
  "version": "0.8.1",
  "private": false,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Repository context management for ethical code review",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vctrx-dev/CCR.git"
  },
  "type": "module",
  "bin": {
    "ccr": "dist/cli/index.cjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./context": {
      "types": "./dist/context/index.d.ts",
      "import": "./dist/context/index.js"
    },
    "./llm": {
      "types": "./dist/llm/index.d.ts",
      "import": "./dist/llm/index.js"
    },
    "./review": {
      "types": "./dist/review/index.d.ts",
      "import": "./dist/review/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "USER_MANUAL.md", "TEST.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "hooks:dev": "husky",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "test:e2e": "vitest run tests/e2e/",
    "test:package": "node scripts/package-smoke.mjs",
    "test:changed": "node scripts/audit.mjs --blast",
    "test:changed:print": "node scripts/audit.mjs --blast --print",
    "audit": "node scripts/audit.mjs",
    "check:staged": "node scripts/check-repository.mjs",
    "check:tracked": "node scripts/check-repository.mjs --tracked",
    "commitlint": "commitlint",
    "format:staged": "lint-staged",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "verify": "pnpm check:tracked && pnpm run audit && pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build && pnpm test:package"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1"
    },
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild", "husky"]
  },
  "lint-staged": {
    "*.{js,json,jsonc,jsx,mjs,mts,ts,tsx}": ["biome check --write"]
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^21.2.2",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "commander": "^15.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "picomatch": "^4.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
