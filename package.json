{
  "name": "@vctrx/ccr",
  "version": "0.3.0",
  "private": false,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Repository context management for ethical code review",
  "type": "module",
  "bin": {
    "ccr": "./dist/cli/index.cjs"
  },
  "files": ["dist/cli", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "hooks:dev": "husky",
    "postinstall": "node dist/cli/index.cjs hooks install --apply || exit 0",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "test:e2e": "vitest run tests/e2e/",
    "test:package": "node scripts/package-smoke.mjs",
    "test:changed": "node scripts/audit.mjs --blast",
    "test:changed:print": "node scripts/audit.mjs --blast --print",
    "audit": "node scripts/audit.mjs",
    "check:staged": "node scripts/check-repository.mjs",
    "check:tracked": "node scripts/check-repository.mjs --tracked",
    "commitlint": "commitlint",
    "format:staged": "lint-staged",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "fixture:record": "tsx scripts/record-pr.ts",
    "fixture:replay": "tsx scripts/replay-review.ts",
    "fixture:refresh-all": "tsx scripts/regenerate-fixtures.ts",
    "verify": "pnpm check:tracked && pnpm run audit && pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build && pnpm test:package"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild", "husky"]
  },
  "lint-staged": {
    "*.{js,json,jsonc,jsx,mjs,mts,ts,tsx}": ["biome check --write"]
  },
  "devDependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^21.2.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "commander": "^15.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "picomatch": "^4.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0",
    "zod": "^4.4.3"
  }
}
